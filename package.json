  },
  "dependencies": { "next": "^15.5.0", "react": "^19.1.0", "react-dom": "^19.1.0" },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0", "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0", "@types/react": "^19.1.0", "@types/react-dom": "^19.1.0",
    "eslint": "^9.0.0", "eslint-config-next": "^15.5.0", "typescript": "^5.8.0"
  }
}
